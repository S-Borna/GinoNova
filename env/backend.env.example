# DevOpsHub Backend Environment Variables
# Copy to .env for local development or set in Railway dashboard

# Application
PROJECT_VERSION="v1.0.0"
RAILWAY_ENV="production"

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL="sqlite:///./devopshub.db"
# DATABASE_URL="postgresql://user:password@host:5432/devopshub"

# JWT Authentication
JWT_SECRET="your-super-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_HOURS="24"

# CORS Origins (comma-separated)
CORS_ORIGINS="https://saasprojekt.netlify.app,http://localhost:3000"
API_ORIGINS="*"

# OpenAI (for AI features)
# OPENAI_API_KEY="sk-..."

# Email (for password reset, future)
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASSWORD=""

# Redis (for caching, future)
# REDIS_URL=""

# Notion Integration (DevOpsHub Control Center)
# Create an Internal Integration at https://www.notion.so/my-integrations
# NOTION_API_KEY="secret_..."
# NOTION_DATABASE_ID="your-database-id"
