# DevOpsHub Frontend Environment Variables
# Copy to .env.local for local development or set in Netlify dashboard

# Backend API URL
NEXT_PUBLIC_API_URL="https://saas-project-production-31f8.up.railway.app"

# Site URL (for canonical URLs and Open Graph)
NEXT_PUBLIC_SITE_URL="https://saasprojekt.netlify.app"

# Environment
NEXT_PUBLIC_ENV="production"

# ============================================================================
# NEXTAUTH CONFIGURATION (Required for OAuth)
# ============================================================================

# NextAuth secret - Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl"

# NextAuth URL - Your frontend URL
NEXTAUTH_URL="https://saids-devopshub.netlify.app"

# ============================================================================
# OAUTH PROVIDERS (Get credentials from each provider)
# ============================================================================

# Google OAuth
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://saids-devopshub.netlify.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
# Create at: https://github.com/settings/developers
# Authorization callback URL: https://saids-devopshub.netlify.app/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Discord OAuth
# Create at: https://discord.com/developers/applications
# Redirect URI: https://saids-devopshub.netlify.app/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ============================================================================
# ANALYTICS (optional - for future GA4/Mixpanel integration)
# ============================================================================
# NEXT_PUBLIC_GA_TRACKING_ID=""
# NEXT_PUBLIC_MIXPANEL_TOKEN=""

# ============================================================================
# MUSIC NOW PLAYING WIDGET - Pure Last.fm (No Spotify needed!)
# ============================================================================
# Full guide: See /docs/README_MUSIC_SETUP.md

# Last.fm (for real-time now playing data)
# Get free API key at: https://www.last.fm/api/account/create
# Connect Spotify to Last.fm: https://www.last.fm/settings/applications
LASTFM_API_KEY=""
LASTFM_USERNAME=""

# Feature Flags (optional)
# NEXT_PUBLIC_ENABLE_ANALYTICS="true"
# NEXT_PUBLIC_ENABLE_ERROR_REPORTING="true"
