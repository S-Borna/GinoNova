# DevOpsHub Frontend Environment Variables
# Copy to .env.local for local development or set in Netlify dashboard

# Backend API URL
NEXT_PUBLIC_API_URL="https://saas-project-production-31f8.up.railway.app"

# Site URL (for canonical URLs and Open Graph)
NEXT_PUBLIC_SITE_URL="https://saasprojekt.netlify.app"

# Environment
NEXT_PUBLIC_ENV="production"

# Analytics (optional - for future GA4/Mixpanel integration)
# NEXT_PUBLIC_GA_TRACKING_ID=""
# NEXT_PUBLIC_MIXPANEL_TOKEN=""

# Feature Flags (optional)
# NEXT_PUBLIC_ENABLE_ANALYTICS="true"
# NEXT_PUBLIC_ENABLE_ERROR_REPORTING="true"
