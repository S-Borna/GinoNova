{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "backend.Dockerfile",
        "watchPatterns": [
            "apps/backend/**",
            "packages/shared/python/**"
        ]
    },
    "deploy": {
        "startCommand": "python -m alembic upgrade head && uvicorn src.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 4",
        "healthcheckPath": "/health",
        "restartPolicyType": "ON_FAILURE"
    }
}