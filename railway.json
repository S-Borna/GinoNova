{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "backend.Dockerfile",
        "watchPatterns": [
            "apps/backend/**",
            "packages/shared/python/**"
        ]
    },
    "deploy": {
        "healthcheckPath": "/health",
        "restartPolicyType": "ON_FAILURE"
    }
}