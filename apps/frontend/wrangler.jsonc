{
    "$schema": "node_modules/wrangler/config-schema.json",
    "main": ".open-next/worker.js",
    "name": "saas-project",
    "compatibility_date": "2024-12-30",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "vars": {
        "NEXT_PUBLIC_API_URL": "https://api.ginonova.com"
    },
    "routes": [
        {
            "pattern": "ginonova.com/*",
            "zone_name": "ginonova.com"
        },
        {
            "pattern": "www.ginonova.com/*",
            "zone_name": "ginonova.com"
        }
    ]
}