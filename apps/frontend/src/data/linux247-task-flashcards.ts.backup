// TASK 4: SYSTEM INFO (30 flashcards)
// =============================================================================

const TASK_4_FLASHCARDS: TaskFlashcard[] = [
  // Easy (10)
  { id: 'l4-1', front: 'Hur visar du systemets hostname?', back: 'hostname\neller: cat /etc/hostname', category: 'System', difficulty: 'easy' },
