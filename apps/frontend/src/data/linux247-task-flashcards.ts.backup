// =============================================================================
// TASK 11: PERMISSIONS (30 flashcards)
// =============================================================================

const TASK_11_FLASHCARDS: TaskFlashcard[] = [
  // Easy (10)
  { id: 'l11-1', front: 'Hur visar du filrättigheter?', back: 'ls -l\nEx: -rw-r--r--', category: 'Visa', difficulty: 'easy' },
  { id: 'l11-2', front: 'Vad betyder rwx?', back: 'r = read (4)\nw = write (2)\nx = execute (1)', category: 'Koncept', difficulty: 'easy' },
  { id: 'l11-3', front: 'Hur ändrar du rättigheter?', back: 'chmod 755 fil\nchmod u+x fil', category: 'chmod', difficulty: 'easy' },
  { id: 'l11-4', front: 'Vad betyder 755?', back: 'user: rwx (7)\ngroup: r-x (5)\nothers: r-x (5)', category: 'Oktalt', difficulty: 'easy' },
  { id: 'l11-5', front: 'Hur ändrar du ägare?', back: 'sudo chown user fil\nsudo chown user:group fil', category: 'chown', difficulty: 'easy' },
  { id: 'l11-6', front: 'Hur ändrar du grupp?', back: 'sudo chgrp group fil', category: 'chgrp', difficulty: 'easy' },
  { id: 'l11-7', front: 'Vad är de tre permission-grupperna?', back: 'u = user (ägare)\ng = group\no = others', category: 'Koncept', difficulty: 'easy' },
  { id: 'l11-8', front: 'Hur gör du fil körbar?', back: 'chmod +x fil\neller: chmod 755 fil', category: 'chmod', difficulty: 'easy' },
  { id: 'l11-9', front: 'Hur tar du bort write för others?', back: 'chmod o-w fil', category: 'chmod', difficulty: 'easy' },
  { id: 'l11-10', front: 'Vad betyder 644?', back: 'user: rw- (6)\ngroup: r-- (4)\nothers: r-- (4)', category: 'Oktalt', difficulty: 'easy' },
  // Medium (12)
  { id: 'l11-11', front: 'Hur ändrar du rekursivt?', back: 'chmod -R 755 katalog/\nchown -R user:group katalog/', category: 'Rekursiv', difficulty: 'medium' },
  { id: 'l11-12', front: 'Vad betyder första tecknet i ls -l?', back: '- = fil\nd = katalog\nl = länk', category: 'Visa', difficulty: 'medium' },
  { id: 'l11-13', front: 'Vad är umask?', back: 'Default permission mask.\numask 022 = nya filer får 644', category: 'umask', difficulty: 'medium' },
  { id: 'l11-14', front: 'Hur visar du umask?', back: 'umask\numask -S (symbolisk)', category: 'umask', difficulty: 'medium' },
  { id: 'l11-15', front: 'Vad är SUID bit?', back: 'Kör som filens ägare.\nchmod u+s fil\nVisa: -rws', category: 'Special', difficulty: 'medium' },
  { id: 'l11-16', front: 'Vad är SGID bit?', back: 'Kör som filens grupp.\nPå katalog: nya filer ärver grupp.', category: 'Special', difficulty: 'medium' },
  { id: 'l11-17', front: 'Vad är sticky bit?', back: 'På katalog: endast ägare kan ta bort.\nchmod +t katalog\nVisa: drwxrwxrwt', category: 'Special', difficulty: 'medium' },
  { id: 'l11-18', front: 'Hur sätter du SUID oktalt?', back: 'chmod 4755 fil\n4 = SUID', category: 'Special', difficulty: 'medium' },
  { id: 'l11-19', front: 'Hur sätter du sticky bit oktalt?', back: 'chmod 1777 katalog\n1 = sticky', category: 'Special', difficulty: 'medium' },
  { id: 'l11-20', front: 'Vilka filer har ofta SUID?', back: '/usr/bin/passwd\n/usr/bin/sudo', category: 'Special', difficulty: 'medium' },
  { id: 'l11-21', front: 'Hur hittar du SUID-filer?', back: 'find / -perm -4000 2>/dev/null', category: 'Söka', difficulty: 'medium' },
  { id: 'l11-22', front: 'Hur kopierar du med bevarade rättigheter?', back: 'cp -p fil kopia\ncp -a katalog/ (arkiv)', category: 'Kopiera', difficulty: 'medium' },
  // Hard (8)
  { id: 'l11-23', front: 'Vad är ACL?', back: 'Access Control Lists.\nMer granulär än standard permissions.', category: 'ACL', difficulty: 'hard' },
  { id: 'l11-24', front: 'Hur visar du ACL?', back: 'getfacl fil', category: 'ACL', difficulty: 'hard' },
  { id: 'l11-25', front: 'Hur sätter du ACL?', back: 'setfacl -m u:user:rw fil\nsetfacl -m g:group:rx fil', category: 'ACL', difficulty: 'hard' },
  { id: 'l11-26', front: 'Hur tar du bort ACL?', back: 'setfacl -x u:user fil\nsetfacl -b fil (alla)', category: 'ACL', difficulty: 'hard' },
  { id: 'l11-27', front: 'Vad är immutable attribute?', back: 'Fil kan inte ändras/tas bort.\nsudo chattr +i fil', category: 'Attribut', difficulty: 'hard' },
  { id: 'l11-28', front: 'Hur visar du fil-attribut?', back: 'lsattr fil', category: 'Attribut', difficulty: 'hard' },
  { id: 'l11-29', front: 'Vad är capabilities?', back: 'Finare privilegier än root.\nsetcap, getcap', category: 'Caps', difficulty: 'hard' },
  { id: 'l11-30', front: 'Hur sätter du capability?', back: 'sudo setcap cap_net_bind_service+ep /path/binary', category: 'Caps', difficulty: 'hard' }
]

// =============================================================================
// TASK 12: COMPRESSION (30 flashcards)
// =============================================================================

