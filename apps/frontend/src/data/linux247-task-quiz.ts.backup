/**
 * Linux 24/7 Tentaplugg - Task-specifika Quiz
 * 20 quiz per task, varierad correctIndex (0-3)
 */

export interface TaskQuizQuestion {
    id: string
    question: string
    options: string[]
    correctIndex: number
    explanation: string
    difficulty: 'G' | 'VG'
    category: string
}

export interface TaskQuizSet {
    taskId: string
    taskTitle: string
    questions: TaskQuizQuestion[]
}

